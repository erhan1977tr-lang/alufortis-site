# Alufortis: GreenGeeks (Apache / LiteSpeed) statik yayın ayarları.
# Bu dosya build sırasında out/.htaccess olarak kopyalanır.
# Adı içerik özeti (hash) taşıyan tek klasör _next/static/; onun için ayrı .htaccess
# build sonrası scripts/postbuild.mjs ile üretilir.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType text/plain .txt
</IfModule>

# HTTP isteklerini HTTPS'e yönlendir. AutoSSL doğrulaması için .well-known hariç tutulur.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Hata sayfası gibi sunucunun iç yönlendirmelerine dokunma
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Sunucunun varsayılan Expires başlıkları aşağıdaki Cache-Control kurallarıyla çakışmasın
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Adı hash içermeyen dosyalar (HTML, index.txt, 404 sayfası): her istekte sunucuya sorulur
  Header set Cache-Control "no-cache"

  # Hash içermeyen görseller (ör. icon.svg): bir gün
  <FilesMatch "\.(svg|ico|png|jpe?g|webp|avif|gif)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript image/svg+xml application/json
</IfModule>
